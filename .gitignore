# ============================================================
#  GitHub에 절대 올리면 안 되는 파일 목록
#  ------------------------------------------------------------
#  이 저장소는 Public(공개)입니다. 여기 적힌 파일은 git이 알아서
#  빼고 올리므로, 실수로 개인정보가 공개되는 일을 막아줍니다.
#
#  ※ 마우스로 끌어다 놓아 올릴 때는 git이 관여하지 않습니다.
#     그때는 아래 파일들을 직접 빼고 올려야 합니다. (README 12번 항목)
# ============================================================

# ── 이메일 주소가 그대로 적힌 내 메모 ──
LOCAL_ONLY_*

# ── 예전 파일 보관 폴더 (2026-08-14 추가) ──
#    안의 README 3개에 이메일 주소가 평문으로 적혀 있어서 올리지 않습니다.
#    ※ 폴더 이름이 '#' 으로 시작하면 .gitignore 가 주석으로 오해하므로
#      앞에 역슬래시(\)를 붙여야 합니다.
\# prev/

# ── 앱에서 [JSON 내보내기]로 받은 백업 ──
#    기록 본문 + 이메일 주소 + GAS 주소가 암호 없이 들어 있습니다
why2korea_memo_*.json

# ── 암호를 풀어놓은 중간 파일을 만들었다면 ──
*.plain.json
*.decrypted.*

# ── 클로드 코드 개인 설정 (내 PC 경로가 들어 있습니다) ──
.claude/

# ── 파이썬 찌꺼기 ──
__pycache__/
*.pyc

# ── 운영체제·편집기가 만드는 잡파일 ──
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
