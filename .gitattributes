# ============================================================
#  줄바꿈(개행) 규칙
#  ------------------------------------------------------------
#  윈도우 git 은 기본값이 core.autocrlf=true 라서
#  "LF will be replaced by CRLF" 경고를 매번 띄웁니다.
#
#  이 파일이 있으면 어느 PC에서 받아도 줄바꿈이 LF 로 통일되고
#  그 경고도 더 이상 나오지 않습니다.
#  (저장소에 들어가는 내용은 전부터 이미 LF 였습니다 — 바뀌는 것 없음)
# ============================================================

# 글자 파일은 전부 LF 로 저장하고 LF 로 꺼냅니다
* text=auto eol=lf

# 그림·바이너리는 손대지 않습니다 (건드리면 파일이 깨집니다)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
